# ==============================================================================
# CHINTAN GPT ENVIRONMENT CONFIGURATION
# ==============================================================================

# AI SERVICES:
# Required for Gemini AI course assistance, code explanations, and mock interviews.
GEMINI_API_KEY=""

# APPLICATION DEPLOYMENT:
# The base URL where this app is hosted (injected automatically in Cloud Run or Vercel).
APP_URL=""
VITE_API_BASE_URL=""

# YOUTUBE INTEGRATION (OPTIONAL):
# Optional YouTube Data API v3 key for real-time playlist synchronisation.
YOUTUBE_API_KEY=""

# DEFAULT SEED CREDENTIALS (DEVELOPMENT/STAGING):
ADMIN_DEFAULT_PASSWORD=""
STUDENT_DEFAULT_PASSWORD=""

# AUTHENTICATION & SECURITY:
# Required secret key used to sign and verify HMAC-SHA256 JWT tokens.
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# DATABASE PERSISTENCE:
# Path to persistent database storage file for local development (default: server/data/persistent_db.json)
# Note: LocalJsonAdapter is strictly prohibited in production mode.
DB_FILE_PATH=""

# PRODUCTION MANAGED CLOUD DATABASE (FIRESTORE):
# The Google Cloud / Firebase project ID for managed Firestore persistence in production.
# Required in production; system strictly fails closed if missing or unreachable.
FIRESTORE_PROJECT_ID=""
FIRESTORE_DATABASE_ID="(default)"
# Path to Google Cloud Service Account JSON key or JSON string in FIREBASE_SERVICE_ACCOUNT_KEY
GOOGLE_APPLICATION_CREDENTIALS=""
FIREBASE_SERVICE_ACCOUNT_KEY=""

# ==============================================================================
# SECURE ISOLATED CODE EXECUTION CONFIGURATION
# ==============================================================================
# Untrusted user code is NEVER executed inside the main application or Vercel process.
# All untrusted execution is routed over HTTP to a separately hosted isolated execution service.
#
# CODE_EXECUTION_PROVIDER:
#   - "judge0"  : Uses a self-hosted or managed Judge0 API cluster
#   - "piston"  : Uses a self-hosted Piston execution cluster (v2 API)
#   - "none"    : Disables execution (fails closed safely with 'service not configured')
CODE_EXECUTION_PROVIDER="judge0"

# CODE_EXECUTION_BASE_URL:
# The HTTP endpoint of the external isolated execution cluster.
# Examples:
#   - Self-hosted Judge0: "http://judge0-server.internal:2358" or "https://judge0.yourdomain.com"
#   - Self-hosted Piston: "http://piston-server.internal:2000" or "https://piston.yourdomain.com"
# If left unset or unreachable, the system strictly fails closed and returns an error.
CODE_EXECUTION_BASE_URL=""

# CODE_EXECUTION_API_KEY:
# Optional API key / authorization token for authenticated Judge0 or Piston instances.
CODE_EXECUTION_API_KEY=""

# CODE_EXECUTION_TIMEOUT_MS:
# Maximum execution duration before timing out (in milliseconds). Default: 8000ms.
CODE_EXECUTION_TIMEOUT_MS="8000"
